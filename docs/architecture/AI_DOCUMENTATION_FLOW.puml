@startuml AI Documentation Flow

!theme plain

title AI Documentation Flow

start

:AI_BOOTSTRAP.md;

:00_READ_FIRST.md;

:PROJECT_CONTEXT.md;

:ARCHITECTURE_FINGERPRINT.md;

if (Need Session History?) then (yes)
  :AI_SESSION_REPORT.md;
endif

if (Need Frozen Decisions?) then (yes)
  :AI_DECISIONS.md;
endif

if (Need Architecture Evolution?) then (yes)
  :ARCHITECTURE_CHANGELOG.md;
endif

